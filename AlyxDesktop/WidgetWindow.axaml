<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:AlyxDesktop.Controls"
        xmlns:local="using:AlyxDesktop"
        x:Class="AlyxDesktop.WidgetWindow"
        Title="Alyx"
        Icon="/Assets/logo.ico"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        WindowStartupLocation="Manual"
        Width="144" Height="144"
        Opacity="0"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource Ink}">

  <Window.Styles>
    <!-- Orbe -->
    <Style Selector="Border#Orb">
      <Setter Property="BoxShadow" Value="0 0 0 1 #2EE8C81E, 0 12 40 0 #2414201A" />
      <Setter Property="Transitions">
        <Transitions>
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.4" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#Orb:pointerover">
      <Setter Property="BoxShadow" Value="0 0 0 1 #66E8C81E, 0 12 40 0 #2414201A, 0 0 36 0 #59E8C81E" />
    </Style>
    <Style Selector="Border#Orb.busy">
      <Setter Property="BoxShadow" Value="0 0 0 1 #66E8C81E, 0 12 40 0 #2414201A, 0 0 40 0 #47E8C81E" />
    </Style>

    <!-- Languette de bord (présence discrète) -->
    <Style Selector="Border#EdgeTab">
      <Setter Property="Background" Value="{DynamicResource PanelSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder28}" />
      <Setter Property="BoxShadow" Value="0 6 20 0 #2214201A" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.3" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#EdgeTab:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BoxShadow" Value="0 8 24 0 #2614201A, 0 0 24 0 #47E8C81E" />
    </Style>
    <Style Selector="Border#EdgeTab.busy">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
      <Setter Property="BoxShadow" Value="0 8 24 0 #2614201A, 0 0 28 0 #47E8C81E" />
    </Style>

    <!-- Bulles du menu radial -->
    <Style Selector="Button.node">
      <Setter Property="Width" Value="72" />
      <Setter Property="Height" Value="72" />
      <Setter Property="CornerRadius" Value="36" />
      <Setter Property="Background" Value="{DynamicResource NodeSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder28}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.node:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
  </Window.Styles>

  <Canvas x:Name="Viewport" ClipToBounds="True">
    <Canvas x:Name="Stage">

      <!-- Voile d'arrière-plan pour le mode Overlay centré -->
      <Border x:Name="Scrim" Background="{StaticResource OverlayScrim}" Opacity="0" IsVisible="False" IsHitTestVisible="False" />

      <!-- Indice de premier lancement -->
      <StackPanel x:Name="Hint" Spacing="2" IsHitTestVisible="False" IsVisible="False">
        <TextBlock x:Name="HintTitle" Text="Clique pour ouvrir Alyx" FontSize="13" HorizontalAlignment="Right" />
        <TextBlock x:Name="HintSub" Text="glisser pour déplacer · Alt+J" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" />
      </StackPanel>

      <!-- Bulles du menu radial (créées dans le code) -->
      <Canvas x:Name="NodeLayer" />

      <!-- Panneau (Card / Side / Overlay) -->
      <Panel x:Name="PanelHost" IsVisible="False">
        <Border x:Name="PanelCard" CornerRadius="{DynamicResource WidgetCornerRadius}" Background="{DynamicResource PanelSurface}"
                BorderBrush="{DynamicResource WidgetBorder}" BorderThickness="{DynamicResource WidgetBorderThickness}" ClipToBounds="True"
                BoxShadow="0 20 60 -10 #1E0284C7, 0 10 30 -5 #18EC4899">
          <local:AlyxPanel x:Name="Panel" />
        </Border>
      </Panel>

      <!-- Languette de bord galet aquarelle (10×56 au repos, 36×56 au survol) -->
      <Border x:Name="EdgeTab" Width="10" Height="56" CornerRadius="16,0,0,16" BorderThickness="1,1,0,1"
              Cursor="Hand" IsVisible="False" ToolTip.Tip="Alyx (Alt+J)" AutomationProperties.Name="Ouvrir Alyx">
        <Panel>
          <Border x:Name="EdgeTabBar" Width="3" Height="22" CornerRadius="1.5" Background="{DynamicResource Accent}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
          <c:AlyxEye x:Name="EdgeTabEye" Width="26" Height="26" Opacity="0" IsVisible="False"
                     HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Panel>
      </Border>

      <!-- Orbe (classique 84×84 ou mini 48×48) -->
      <Border x:Name="Orb" Width="84" Height="84" CornerRadius="42" Background="White" Cursor="Hand"
              ToolTip.Tip="Alyx (Alt+J)" AutomationProperties.Name="Ouvrir Alyx">
        <Border.RenderTransform>
          <ScaleTransform ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <c:AlyxEye x:Name="OrbEye" Width="72" Height="72" IsHitTestVisible="False" />
      </Border>
    </Canvas>
  </Canvas>
</Window>
