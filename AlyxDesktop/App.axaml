<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AlyxDesktop.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <!-- Typographie : Rubik SemiBold (Néo-brutalisme UI), Manrope, JetBrains Mono (données/code), Fredoka Medium (horloge) -->
    <FontFamily x:Key="UiFont">avares://AlyxDesktop/Assets/Fonts#Rubik, avares://AlyxDesktop/Assets/Fonts#Manrope, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="StyleUiFont">avares://AlyxDesktop/Assets/Fonts#Rubik, avares://AlyxDesktop/Assets/Fonts#Manrope, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFont">avares://AlyxDesktop/Assets/Fonts#JetBrains Mono, Fira Code, Consolas, monospace</FontFamily>
    <FontFamily x:Key="DisplayFont">avares://AlyxDesktop/Assets/Fonts#Rubik, avares://AlyxDesktop/Assets/Fonts#Fredoka Medium, avares://AlyxDesktop/Assets/Fonts#Manrope, sans-serif</FontFamily>

    <!-- Palette Maîtresse : Canopée & Ambre (#F6EED9, #1F2C2A, #384C48, #7DAE9B, #FBA620, #FFE866) -->
    <Color x:Key="ColorCanopeeCream">#F6EED9</Color>
    <Color x:Key="ColorCanopeeDark">#1F2C2A</Color>
    <Color x:Key="ColorCanopeeSapin">#384C48</Color>
    <Color x:Key="ColorCanopeeSauge">#7DAE9B</Color>
    <Color x:Key="ColorCanopeeAmbre">#FBA620</Color>
    <Color x:Key="ColorCanopeeSoleil">#FFE866</Color>
    <Color x:Key="ColorCanopeeSurfaceLight">#FBF6EA</Color>
    <Color x:Key="ColorCanopeeSurfaceDark">#243230</Color>

    <SolidColorBrush x:Key="CanopeeCream" Color="{StaticResource ColorCanopeeCream}" />
    <SolidColorBrush x:Key="CanopeeDark" Color="{StaticResource ColorCanopeeDark}" />
    <SolidColorBrush x:Key="CanopeeSapin" Color="{StaticResource ColorCanopeeSapin}" />
    <SolidColorBrush x:Key="CanopeeSauge" Color="{StaticResource ColorCanopeeSauge}" />
    <SolidColorBrush x:Key="CanopeeAmbre" Color="{StaticResource ColorCanopeeAmbre}" />
    <SolidColorBrush x:Key="CanopeeSoleil" Color="{StaticResource ColorCanopeeSoleil}" />

    <!-- Dégradé Iris Canopée & Ambre pour l'Œil Alyx -->
    <LinearGradientBrush x:Key="CanopeeIris" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#384C48" Offset="0.0" />
      <GradientStop Color="#7DAE9B" Offset="0.55" />
      <GradientStop Color="#FBA620" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Tokens Aquarelle & Minimaliste (Conservés pour compatibilité de styles) -->
    <SolidColorBrush x:Key="WatercolorBlue" Color="#0284C7" />
    <SolidColorBrush x:Key="WatercolorRose" Color="#EC4899" />
    <SolidColorBrush x:Key="WatercolorLightBlue" Color="#7DD3FC" />
    <SolidColorBrush x:Key="WatercolorLightRose" Color="#F9A8D4" />
    <SolidColorBrush x:Key="WatercolorPaper" Color="#FAF9F6" />
    <SolidColorBrush x:Key="WatercolorDark" Color="#0D0E12" />
    <SolidColorBrush x:Key="WatercolorInk" Color="#14151A" />

    <LinearGradientBrush x:Key="WatercolorCardWash" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#8CE0F2FE" Offset="0.0" />
      <GradientStop Color="#F2FFFFFF" Offset="0.5" />
      <GradientStop Color="#8CFCE7F3" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WatercolorIris" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#38BDF8" Offset="0.0" />
      <GradientStop Color="#0284C7" Offset="0.52" />
      <GradientStop Color="#EC4899" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Tokens Néo-Brutalistes Canopée (Actifs par défaut) -->
    <SolidColorBrush x:Key="Bg" Color="#F6EED9" />
    <SolidColorBrush x:Key="Surface" Color="#FBF6EA" />
    <SolidColorBrush x:Key="CardSurface" Color="#FBF6EA" />
    <SolidColorBrush x:Key="ChipSurface" Color="#FBF6EA" />
    <SolidColorBrush x:Key="StyleBorder" Color="#384C48" />
    <SolidColorBrush x:Key="WidgetBorder" Color="#384C48" />
    <SolidColorBrush x:Key="PrimaryButton" Color="#384C48" />
    <SolidColorBrush x:Key="PrimaryButtonText" Color="#F6EED9" />
    <CornerRadius x:Key="CardCornerRadius">24</CornerRadius>
    <CornerRadius x:Key="WidgetCornerRadius">28</CornerRadius>
    <CornerRadius x:Key="ChipCornerRadius">999</CornerRadius>
    <CornerRadius x:Key="PrimaryButtonCornerRadius">999</CornerRadius>
    <Thickness x:Key="CardBorderThickness">1</Thickness>
    <Thickness x:Key="WidgetBorderThickness">1</Thickness>
    <!-- Surface opaque pour éviter les fuites de texte en arrière-plan -->
    <SolidColorBrush x:Key="PanelSurface" Color="#F6EED9" />
    <SolidColorBrush x:Key="NodeSurface" Color="#FBF6EA" />
    <SolidColorBrush x:Key="Ink" Color="#384C48" />
    <SolidColorBrush x:Key="Ink2" Color="#243230" />
    <SolidColorBrush x:Key="TextBody" Color="#384C48" />
    <SolidColorBrush x:Key="Muted" Color="#5D726D" />
    <SolidColorBrush x:Key="Faint" Color="#7DAE9B" />
    <SolidColorBrush x:Key="Accent" Color="#384C48" />
    <SolidColorBrush x:Key="AccentText" Color="#384C48" />
    <SolidColorBrush x:Key="AccentDeep" Color="#1F2C2A" />
    <SolidColorBrush x:Key="AccentActivePill" Color="#33FBA620" />
    <SolidColorBrush x:Key="AccentTint" Color="#267DAE9B" />
    <SolidColorBrush x:Key="AccentTint05" Color="#0D7DAE9B" />
    <SolidColorBrush x:Key="AccentTint08" Color="#1A7DAE9B" />
    <SolidColorBrush x:Key="AccentBorder" Color="#66384C48" />
    <SolidColorBrush x:Key="AccentBorder28" Color="#47384C48" />
    <SolidColorBrush x:Key="AccentBorder35" Color="#59384C48" />
    <SolidColorBrush x:Key="AccentFocus" Color="#FBA620" />
    <SolidColorBrush x:Key="OverlayScrim" Color="#331F2C2A" />
    <SolidColorBrush x:Key="GpuChart" Color="#7DAE9B" />
    <SolidColorBrush x:Key="Success" Color="#10B981" />
    <SolidColorBrush x:Key="Danger" Color="#FBA620" />
    <SolidColorBrush x:Key="DangerTint" Color="#26FBA620" />
    <SolidColorBrush x:Key="NeoBorder" Color="#384C48" />
    <SolidColorBrush x:Key="Hair6" Color="#14384C48" />
    <SolidColorBrush x:Key="Hair7" Color="#1A384C48" />
    <SolidColorBrush x:Key="Hair8" Color="#24384C48" />
    <SolidColorBrush x:Key="Hair9" Color="#33384C48" />
    <SolidColorBrush x:Key="Hair10" Color="#47384C48" />
    <SolidColorBrush x:Key="Hair12" Color="#59384C48" />
    <SolidColorBrush x:Key="Hair14" Color="#6B384C48" />
    <SolidColorBrush x:Key="Fill025" Color="#0B384C48" />
    <SolidColorBrush x:Key="Fill035" Color="#10384C48" />
    <SolidColorBrush x:Key="Fill04" Color="#14384C48" />
    <SolidColorBrush x:Key="Fill07" Color="#1E384C48" />
    <SolidColorBrush x:Key="Fill08" Color="#26384C48" />
    <SolidColorBrush x:Key="Fill10" Color="#30384C48" />
    <SolidColorBrush x:Key="Fill12" Color="#3A384C48" />

    <!-- Curseurs (volume / luminosité) aux couleurs Canopée & Ambre -->
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#384C48" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#384C48" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#1F2C2A" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#FBA620" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FBA620" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#E59419" />
    <SolidColorBrush x:Key="SliderTrackFill" Color="#2B384C48" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#38384C48" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Bouton « nu » (équivalent de all:unset) : aucun habillage Fluent -->
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_Flat"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.flat:disabled">
      <Setter Property="Opacity" Value=".45" />
    </Style>
    <Style Selector="Button.flat.hover-fill:pointerover">
      <Setter Property="Background" Value="{DynamicResource Fill07}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Button.flat.hover-accent:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Button.flat.hover-danger:pointerover">
      <Setter Property="Background" Value="{DynamicResource DangerTint}" />
      <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    </Style>
    <Style Selector="Button.flat.hover-ink:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>

    <!-- Champ de saisie sans habillage (le cadre est porté par le parent) -->
    <Style Selector="TextBox.bare">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,3" />
      <Setter Property="MinHeight" Value="21" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentBorder}" />
    </Style>
    <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.bare /template/ TextBlock#PART_Watermark">
      <Setter Property="Foreground" Value="{DynamicResource Faint}" />
    </Style>

    <!-- Texte sélectionnable des messages -->
    <Style Selector="SelectableTextBlock">
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentBorder}" />
    </Style>

    <!-- « Alyx réfléchit » : trois points pulsés -->
    <Style Selector="Ellipse.jdot">
      <Setter Property="Width" Value="5" />
      <Setter Property="Height" Value="5" />
      <Setter Property="Fill" Value="{DynamicResource Accent}" />
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value=".2" /></KeyFrame>
          <KeyFrame Cue="40%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="80%"><Setter Property="Opacity" Value=".2" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value=".2" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Ellipse.jdot.d2">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.15" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value=".2" /></KeyFrame>
          <KeyFrame Cue="40%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="80%"><Setter Property="Opacity" Value=".2" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value=".2" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Ellipse.jdot.d3">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.3" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value=".2" /></KeyFrame>
          <KeyFrame Cue="40%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="80%"><Setter Property="Opacity" Value=".2" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value=".2" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/logo.ico" ToolTipText="Alyx — Alt+Espace" Clicked="OnTrayClicked">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Ouvrir / Masquer Alyx (Alt+Espace)" Click="OnTrayToggle" />
            <NativeMenuItem Header="Format du panneau">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="Carte" ToggleType="Radio" Click="OnTrayLayoutCard" />
                  <NativeMenuItem Header="Panneau latéral (Side)" ToggleType="Radio" Click="OnTrayLayoutSide" />
                  <NativeMenuItem Header="Overlay centré" ToggleType="Radio" Click="OnTrayLayoutOverlay" />
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Présence sur le bureau">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="Languette de bord (discret)" ToggleType="Radio" Click="OnTrayIdleEdgeTab" />
                  <NativeMenuItem Header="Caché (Systray + Alt+Espace uniquement)" ToggleType="Radio" Click="OnTrayIdleStealth" />
                  <NativeMenuItem Header="Mini-orbe (48 px)" ToggleType="Radio" Click="OnTrayIdleMiniOrb" />
                  <NativeMenuItem Header="Orbe classique (84 px)" ToggleType="Radio" Click="OnTrayIdleOrb" />
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Recentrer" Click="OnTrayRecenter" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Quitter Alyx" Click="OnTrayQuit" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
