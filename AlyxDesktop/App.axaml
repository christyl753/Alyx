<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AlyxDesktop.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <!-- Typographie : Manrope (UI), JetBrains Mono (données), Fredoka Medium (affichage / horloge) -->
    <FontFamily x:Key="UiFont">avares://AlyxDesktop/Assets/Fonts#Manrope</FontFamily>
    <FontFamily x:Key="MonoFont">avares://AlyxDesktop/Assets/Fonts#JetBrains Mono</FontFamily>
    <FontFamily x:Key="DisplayFont">avares://AlyxDesktop/Assets/Fonts#Fredoka Medium, avares://AlyxDesktop/Assets/Fonts#Fredoka SemiBold, avares://AlyxDesktop/Assets/Fonts#Manrope, sans-serif</FontFamily>

    <!-- Tokens Aquarelle & Minimaliste (Blanc porcelaine, Lavis bleu céleste et rose pétale, Encre) -->
    <SolidColorBrush x:Key="WatercolorBlue" Color="#0284C7" />
    <SolidColorBrush x:Key="WatercolorRose" Color="#EC4899" />
    <SolidColorBrush x:Key="WatercolorLightBlue" Color="#7DD3FC" />
    <SolidColorBrush x:Key="WatercolorLightRose" Color="#F9A8D4" />
    <SolidColorBrush x:Key="WatercolorPaper" Color="#FAF9F6" />
    <SolidColorBrush x:Key="WatercolorDark" Color="#0D0E12" />
    <SolidColorBrush x:Key="WatercolorInk" Color="#14151A" />

    <LinearGradientBrush x:Key="WatercolorCardWash" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#8CE0F2FE" Offset="0.0" />
      <GradientStop Color="#F2FFFFFF" Offset="0.5" />
      <GradientStop Color="#8CFCE7F3" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WatercolorIris" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#38BDF8" Offset="0.0" />
      <GradientStop Color="#0284C7" Offset="0.52" />
      <GradientStop Color="#EC4899" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Tokens du thème actif (adaptables dynamiquement au mode clair/sombre et palette) -->
    <SolidColorBrush x:Key="Bg" Color="#FAF9F6" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <!-- Surface opaque blanche pour éviter les fuites de texte en arrière-plan -->
    <SolidColorBrush x:Key="PanelSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NodeSurface" Color="#F5FFFFFF" />
    <SolidColorBrush x:Key="Ink" Color="#14151A" />
    <SolidColorBrush x:Key="Ink2" Color="#27272A" />
    <SolidColorBrush x:Key="TextBody" Color="#3F3F46" />
    <SolidColorBrush x:Key="Muted" Color="#71717A" />
    <SolidColorBrush x:Key="Faint" Color="#A1A1AA" />
    <SolidColorBrush x:Key="Accent" Color="#0284C7" />
    <SolidColorBrush x:Key="AccentText" Color="#0369A1" />
    <SolidColorBrush x:Key="AccentDeep" Color="#0C4A6E" />
    <SolidColorBrush x:Key="AccentActivePill" Color="#260284C7" />
    <SolidColorBrush x:Key="AccentTint" Color="#1C0284C7" />
    <SolidColorBrush x:Key="AccentTint05" Color="#0D0284C7" />
    <SolidColorBrush x:Key="AccentTint08" Color="#150284C7" />
    <SolidColorBrush x:Key="AccentBorder" Color="#660284C7" />
    <SolidColorBrush x:Key="AccentBorder28" Color="#470284C7" />
    <SolidColorBrush x:Key="AccentBorder35" Color="#590284C7" />
    <SolidColorBrush x:Key="AccentFocus" Color="#730284C7" />
    <SolidColorBrush x:Key="OverlayScrim" Color="#260D0E12" />
    <SolidColorBrush x:Key="GpuChart" Color="#38BDF8" />
    <SolidColorBrush x:Key="Success" Color="#10B981" />
    <SolidColorBrush x:Key="Danger" Color="#EC4899" />
    <SolidColorBrush x:Key="DangerTint" Color="#1AEF4444" />
    <SolidColorBrush x:Key="Hair6" Color="#0F14151A" />
    <SolidColorBrush x:Key="Hair7" Color="#1214151A" />
    <SolidColorBrush x:Key="Hair8" Color="#1414151A" />
    <SolidColorBrush x:Key="Hair9" Color="#1814151A" />
    <SolidColorBrush x:Key="Hair10" Color="#1E14151A" />
    <SolidColorBrush x:Key="Hair12" Color="#2414151A" />
    <SolidColorBrush x:Key="Hair14" Color="#2A14151A" />
    <SolidColorBrush x:Key="Fill025" Color="#0614151A" />
    <SolidColorBrush x:Key="Fill035" Color="#0914151A" />
    <SolidColorBrush x:Key="Fill04" Color="#0C14151A" />
    <SolidColorBrush x:Key="Fill07" Color="#1414151A" />
    <SolidColorBrush x:Key="Fill08" Color="#1814151A" />
    <SolidColorBrush x:Key="Fill10" Color="#1F14151A" />
    <SolidColorBrush x:Key="Fill12" Color="#2614151A" />

    <!-- Curseurs (volume / luminosité) aux couleurs de l'accent -->
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#0284C7" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#0284C7" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#0369A1" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#0284C7" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#0284C7" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#0369A1" />
    <SolidColorBrush x:Key="SliderTrackFill" Color="#1F14151A" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#2914151A" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Bouton « nu » (équivalent de all:unset) : aucun habillage Fluent -->
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_Flat"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.flat:disabled">
      <Setter Property="Opacity" Value=".45" />
    </Style>
    <Style Selector="Button.flat.hover-fill:pointerover">
      <Setter Property="Background" Value="{StaticResource Fill07}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style Selector="Button.flat.hover-accent:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style Selector="Button.flat.hover-danger:pointerover">
      <Setter Property="Background" Value="{StaticResource DangerTint}" />
      <Setter Property="Foreground" Value="{StaticResource Danger}" />
    </Style>
    <Style Selector="Button.flat.hover-ink:pointerover">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <!-- Champ de saisie sans habillage (le cadre est porté par le parent) -->
    <Style Selector="TextBox.bare">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,3" />
      <Setter Property="MinHeight" Value="21" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBorder}" />
    </Style>
    <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.bare /template/ TextBlock#PART_Watermark">
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
    </Style>

    <!-- Texte sélectionnable des messages -->
    <Style Selector="SelectableTextBlock">
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBorder}" />
    </Style>

    <!-- « Alyx réfléchit » : trois points pulsés -->
    <Style Selector="Ellipse.jdot">
      <Setter Property="Width" Value="5" />
      <Setter Property="Height" Value="5" />
      <Setter Property="Fill" Value="{StaticResource Accent}" />
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value=".2" /></KeyFrame>
          <KeyFrame Cue="40%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="80%"><Setter Property="Opacity" Value=".2" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value=".2" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Ellipse.jdot.d2">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.15" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value=".2" /></KeyFrame>
          <KeyFrame Cue="40%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="80%"><Setter Property="Opacity" Value=".2" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value=".2" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Ellipse.jdot.d3">
      <Style.Animations>
        <Animation Duration="0:0:1.2" Delay="0:0:0.3" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value=".2" /></KeyFrame>
          <KeyFrame Cue="40%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="80%"><Setter Property="Opacity" Value=".2" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value=".2" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/logo.ico" ToolTipText="Alyx — Alt+J" Clicked="OnTrayClicked">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Ouvrir / Masquer Alyx (Alt+J)" Click="OnTrayToggle" />
            <NativeMenuItem Header="Format du panneau">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="Carte" ToggleType="Radio" Click="OnTrayLayoutCard" />
                  <NativeMenuItem Header="Panneau latéral (Side)" ToggleType="Radio" Click="OnTrayLayoutSide" />
                  <NativeMenuItem Header="Overlay centré" ToggleType="Radio" Click="OnTrayLayoutOverlay" />
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Présence sur le bureau">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="Languette de bord (discret)" ToggleType="Radio" Click="OnTrayIdleEdgeTab" />
                  <NativeMenuItem Header="Caché (Systray + Alt+J uniquement)" ToggleType="Radio" Click="OnTrayIdleStealth" />
                  <NativeMenuItem Header="Mini-orbe (48 px)" ToggleType="Radio" Click="OnTrayIdleMiniOrb" />
                  <NativeMenuItem Header="Orbe classique (84 px)" ToggleType="Radio" Click="OnTrayIdleOrb" />
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Recentrer" Click="OnTrayRecenter" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Quitter Alyx" Click="OnTrayQuit" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
